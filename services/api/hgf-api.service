[Unit]
Description=Hitchhikers Guide private diary API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hgf-api
EnvironmentFile=/etc/hgf-api/api.env
Environment=HGF_API_HOST=127.0.0.1
Environment=HGF_API_PORT=8846
Environment=HOME=/var/lib/hgf-api
Environment=XDG_CACHE_HOME=/var/lib/hgf-api/.cache
ExecStart=/opt/sun-universe-runner/venv/bin/python /opt/hgf-api/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/hgf-api

[Install]
WantedBy=multi-user.target
